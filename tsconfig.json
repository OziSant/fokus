{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": false,
    "checkJs": true,
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@/assets/*": [
        "./assets/*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "**/*.js",
    "**/*.jsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts",
    "assets.d.ts"
  ],
  "exclude": [
    "node_modules",
    "example",
    "scripts",
    "eslint.config.js",
    "example/**/*",
    "**/*.test.ts",
    "**/*.test.tsx"
  ]
}
